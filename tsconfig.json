{
  "compilerOptions": {
    "target": "es6",
    "module": "es2020", // Use "es2020" for ESM
     "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true, // Add this line for ESM
    "experimentalDecorators": true, // Enable decorators
    "emitDecoratorMetadata": true, // Enable metadata for decorators
    "paths": {
      "*": ["./main/*"] // Add this line for ESM
    }
  },
  "include": [
    "./main/**/*.ts"

  ],
  "exclude": [
    "./node_modules",
    "./main/opengeometry-three/examples-vite"
  ]
}
