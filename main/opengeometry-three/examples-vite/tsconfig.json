{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "paths": {
      "@og-three": ["../index.ts"],
      "opengeometry": ["../index.ts"]
    },
    "types": ["vite/client"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "./src/**/*.ts",
    "./playground/**/*.ts",
    "../src/**/*.ts"
  ]
}
